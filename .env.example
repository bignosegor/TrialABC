# Server env: copy to .env.local; never commit your actual key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
STUDENT_SCHEMA_PROFILE=class4
STUDENT_TABLE_ALLOWLIST=posts,media,sources,runs,workspaces,profiles,legacy_records
TOAPI_API_KEY=
# Shared ToAPI text, image analysis and generation budget preset.
STUDENT_TOAPI_BUDGET_CREDITS=100
# Connect Vault once: npm run brand:connect -- /absolute/path/to/Vault
# Import the local snapshot once; saved runtime branding is read from Supabase.

# Optional reserve provider; not used by current PersonalOS text generation.
MINIMAX_API_KEY=
